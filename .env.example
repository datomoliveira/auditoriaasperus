# ==============================================================================
# ROTEAMENTO DE IA COM FALLBACK AUTOMÁTICO (MULTI-PROVEDOR)
# ==============================================================================
# O sistema testa os provedores em cascata. Se um falhar (limite de uso, tempo
# esgotado ou indisponível), ele passa automaticamente para o próximo. Se TODOS
# falharem, o usuário recebe um aviso claro de falha da IA.
#
# Defina a ordem em AI_ROUTING_CHAIN (separado por vírgula).
# ==============================================================================

AI_ROUTING_CHAIN="grok,google,ollama,groq,deepseek,openrouter,cloudflare"

# 1. GROK (xAI) — secret: AI_API_KEY_GROK
AI_API_KEY_GROK=""
AI_ENDPOINT_GROK="https://api.x.ai/v1"
AI_MODEL_GROK="grok-4.7"

# 2. GOOGLE GEMINI — secret: AI_API_KEY_GOOGLE
AI_API_KEY_GOOGLE=""
AI_ENDPOINT_GOOGLE="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL_GOOGLE="gemini-3.8-flash"

# 3. OLLAMA (local/offline ou cloud) — secret: AI_API_KEY_OLLAMA
# Dica: rode `ollama run llama3.2` para usar localmente.
AI_API_KEY_OLLAMA=""
AI_ENDPOINT_OLLAMA="http://localhost:11434/v1"
AI_MODEL_OLLAMA="llama3.2"

# --- Provedores extras opcionais (mantidos para compatibilidade) ---

# GROQ (gratuito, alta velocidade)
GROQ_API_KEY=""
GROQ_ENDPOINT="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# DEEPSEEK
DEEPSEEK_API_KEY=""
DEEPSEEK_ENDPOINT="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# OPENROUTER
OPENROUTER_API_KEY=""
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# CLOUDFLARE WORKERS AI (opcional - cota diária gratuita)
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct"

# Servidor e Sandbox
PORT=8787
ENVIRONMENT="development"
AUDIT_SANDBOX_DIR="/tmp/security-audit-sandbox"
MAX_UPLOAD_SIZE_MB=25
