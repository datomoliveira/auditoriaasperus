# ==============================================================================
# CONFIGURAÇÃO DE ROTEAMENTO DE IA COM FALLBACK AUTOMÁTICO (MULTI-PROVIDER)
# ==============================================================================
# O sistema testa os provedores em cascata. Caso o Provedor 1 falhe (Rate Limit 429,
# Timeout ou indisponibilidade), ele chaveia automaticamente para o Provedor 2, depois 3.
#
# Defina a ordem de preferência separada por vírgula em AI_ROUTING_CHAIN:
# Exemplo: AI_ROUTING_CHAIN="groq,ollama,deepseek,openrouter"
# ==============================================================================

AI_ROUTING_CHAIN="groq,ollama,deepseek,openrouter"

# 1. GROQ (Gratuito, Alta Velocidade - Llama 3.3 70B)
GROQ_API_KEY=""
GROQ_ENDPOINT="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. OLLAMA (100% Local, Offline, Sem custos e Sem limite de tokens)
# Dica: rode `ollama run deepseek-coder:6.7b` ou `ollama run llama3.2`
OLLAMA_ENDPOINT="http://localhost:11434/v1"
OLLAMA_MODEL="deepseek-coder:6.7b"

# 3. DEEPSEEK (Excelente custo-benefício para raciocínio e segurança)
DEEPSEEK_API_KEY=""
DEEPSEEK_ENDPOINT="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-chat"

# 4. OPENROUTER (Acesso a modelos gratuitos como meta-llama/llama-3.3-70b:free)
OPENROUTER_API_KEY=""
OPENROUTER_ENDPOINT="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# 5. CLOUDFLARE WORKERS AI (Opcional - cota diária gratuita Cloudflare)
CLOUDFLARE_AI_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.3-70b-instruct"

# Servidor e Sandbox
PORT=8787
ENVIRONMENT="development"
AUDIT_SANDBOX_DIR="/tmp/security-audit-sandbox"
MAX_UPLOAD_SIZE_MB=25
